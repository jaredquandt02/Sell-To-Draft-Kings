# Copy this file to `.env.local` (that is the file Next.js actually loads).
#   cp .env.example .env.local
#
# `.env.local` is gitignored. Path:
#   /Users/jaredquandt/Gladiator/Sell-To-Draft-Kings/.env.local
#
# Fill values from Supabase → Project Settings → API.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Protect /api/cron (Authorization: Bearer $CRON_SECRET)
CRON_SECRET=local-dev-cron-secret

# classic | gladiator — default for new contests
GAME_MODE=classic

# mock | tank01 | mysportsfeeds | sportsdataio
STATS_PROVIDER=mock
TANK01_API_KEY=
MYSPORTSFEEDS_API_KEY=
SPORTSDATAIO_API_KEY=
