# Supabase (Settings > API in the Supabase dashboard, or `supabase start` locally)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stats provider — one of: tank01, mysportsfeeds, sportsdataio
STATS_PROVIDER=tank01
TANK01_API_KEY=
MYSPORTSFEEDS_API_KEY=
SPORTSDATAIO_API_KEY=
